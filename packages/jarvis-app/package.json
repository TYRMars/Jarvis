{
  "name": "@jarvis/jarvis-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Composition root: env parsing + wiring of all stores/tools/providers + the HTTP server. Subcommands: serve / mcp-serve / init / login / status / workspace. The SOLE place that reads process.env.",
  "bin": {
    "jarvis": "./src/main.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/main.ts",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@jarvis/automation": "workspace:*",
    "@jarvis/channel": "workspace:*",
    "@jarvis/core": "workspace:*",
    "@jarvis/learning": "workspace:*",
    "@jarvis/llm": "workspace:*",
    "@jarvis/lsp": "workspace:*",
    "@jarvis/mcp": "workspace:*",
    "@jarvis/memory": "workspace:*",
    "@jarvis/observability": "workspace:*",
    "@jarvis/project": "workspace:*",
    "@jarvis/router": "workspace:*",
    "@jarvis/server": "workspace:*",
    "@jarvis/skill": "workspace:*",
    "@jarvis/store": "workspace:*",
    "@jarvis/subagents": "workspace:*",
    "@jarvis/tools": "workspace:*",
    "@jarvis/workflow": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@opentelemetry/semantic-conventions": "^1.41.1"
  }
}
